{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ruicx/image-kit/blob/main/src/image_kit/schemas/image.schema.json",
  "title": "Container image family v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "dockerfile",
    "context",
    "platforms",
    "inputs",
    "publish",
    "variants"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "dockerfile": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "const": "."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux/amd64",
          "linux/arm64"
        ]
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publish": {
      "type": "boolean"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "base",
        "build_args",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "not": {
            "const": "latest"
          }
        },
        "base": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "image",
                "digest"
              ],
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "pattern": "(?:^|:)latest$|:master$"
                  }
                },
                "digest": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "context"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                },
                "context": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              }
            }
          ]
        },
        "build_args": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "not": {
              "enum": [
                "BASE_IMAGE",
                "BASE_TAG"
              ]
            }
          }
        },
        "mirror": {
          "enum": [
            "upstream",
            "aliyun"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ssh"
          ],
          "properties": {
            "ssh": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "disabled",
                    "key-only",
                    "password"
                  ]
                }
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test"
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "library": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy": {
          "enum": [
            "required",
            "advisory"
          ]
        },
        "entrypoint": {
          "enum": [
            "bash",
            "image"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "const": "advisory"
              }
            }
          },
          "then": {
            "required": [
              "library"
            ]
          }
        }
      ]
    }
  }
}
